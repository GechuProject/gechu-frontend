openapi: 3.0.3
info:
  title: 게임 추천 서비스 Backend API
  version: 1.0.0
  description: 사용자 취향 기반 게임 추천 웹사이트 개발을 위한 API입니다.
paths:
  /api/v1/admin/interaction-context-rules/:
    get:
      operationId: v1_admin_interaction_context_rules_retrieve
      description: 관리자 권한으로 맥락(발생 위치)별 가중치 규칙 목록을 조회합니다. list_page, detail_page, search_result,
        recommendation, saved_page, onboarding 등 interaction_source별 multiplier와 updated_at이
        반환됩니다. 쿼리 파라미터 없이 GET 요청만 보내면 됩니다.
      summary: 맥락 가중치 목록 조회
      tags:
      - admin
      security:
      - jwtAuth: []
      - BearerAuth:
          type: http
          scheme: bearer
          bearerFormat: JWT
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/InteractionContextRuleListResponse'
              examples:
                성공시응답예시:
                  value:
                    results:
                    - interaction_source: list_page
                      multiplier: '0.90'
                      updated_at: '2025-05-01T00:00:00Z'
                    - interaction_source: recommendation
                      multiplier: '1.40'
                      updated_at: '2025-05-01T00:00:00Z'
                  summary: 성공 시 응답 예시
          description: ''
        '401':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'
              examples:
                인증필요:
                  value:
                    status_code: 401
                    code: UNAUTHORIZED
                    message: 인증이 필요합니다.
                  summary: 인증 필요
          description: 인증되지 않음. Authorization 헤더에 유효한 Bearer 토큰이 필요합니다.
        '403':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'
              examples:
                관리자권한필요:
                  value:
                    status_code: 403
                    code: FORBIDDEN
                    message: 관리자 권한이 필요합니다.
                  summary: 관리자 권한 필요
          description: 권한 없음. is_staff=True인 관리자 계정만 호출할 수 있습니다.
  /api/v1/admin/interaction-context-rules/{source}/:
    patch:
      operationId: v1_admin_interaction_context_rules_partial_update
      description: 관리자 권한으로 특정 interaction_source의 multiplier를 수정합니다. path에 source(list_page,
        detail_page, search_result, recommendation, saved_page, onboarding 중 하나)를
        넣고, body에 수정할 multiplier(0보다 큰 숫자)를 보내면 됩니다. 변경은 이후 발생하는 interaction부터 적용됩니다.
      summary: 맥락 가중치 수정
      parameters:
      - in: path
        name: source
        schema:
          type: string
          enum:
          - detail_page
          - list_page
          - onboarding
          - recommendation
          - saved_page
          - search_result
        description: 수정할 맥락 소스. list_page, detail_page, search_result, recommendation,
          saved_page, onboarding 중 하나
        required: true
      tags:
      - admin
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedInteractionContextRuleUpdateRequestRequest'
            examples:
              요청예시:
                value:
                  multiplier: 2.0
                summary: 요청 예시
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedInteractionContextRuleUpdateRequestRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedInteractionContextRuleUpdateRequestRequest'
      security:
      - jwtAuth: []
      - BearerAuth:
          type: http
          scheme: bearer
          bearerFormat: JWT
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/InteractionContextRuleItem'
              examples:
                성공시응답예시:
                  value:
                    interaction_source: recommendation
                    multiplier: '2.00'
                    updated_at: '2025-06-01T16:00:00Z'
                  summary: 성공 시 응답 예시
          description: ''
        '400':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'
              examples:
                Multiplier범위오류:
                  value:
                    status_code: 400
                    code: MULTIPLIER_INVALID
                    message: multiplier는 0보다 커야 합니다.
                  summary: multiplier 범위 오류
          description: multiplier는 0보다 커야 합니다. 또는 요청 body에 multiplier가 없거나 형식이 잘못된
            경우.
        '401':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'
          description: 인증되지 않음. Authorization 헤더에 유효한 Bearer 토큰이 필요합니다.
        '403':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'
          description: 권한 없음. is_staff=True인 관리자 계정만 호출할 수 있습니다.
        '404':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'
              examples:
                SOURCENOTFOUND:
                  value:
                    status_code: 404
                    code: SOURCE_NOT_FOUND
                    message: 해당 source를 찾을 수 없습니다.
                  summary: SOURCE_NOT_FOUND
          description: 해당 source를 찾을 수 없음. path의 source 값이 DB에 없는 경우입니다.
  /api/v1/admin/interaction-weight-rules/:
    get:
      operationId: v1_admin_interaction_weight_rules_retrieve
      description: 관리자 권한으로 행동 가중치 규칙 목록을 조회합니다.
      summary: 행동 가중치 목록 조회
      tags:
      - admin
      security:
      - jwtAuth: []
      - BearerAuth:
          type: http
          scheme: bearer
          bearerFormat: JWT
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/InteractionWeightRuleListResponse'
              examples:
                응답예시:
                  value:
                    results:
                    - interaction_type: view
                      base_weight: '1.00'
                      cooldown_seconds: 60
                      repeat_decay: '0.800'
                      updated_at: '2025-01-01T00:00:00Z'
                  summary: 응답 예시
          description: ''
        '401':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'
              examples:
                인증필요:
                  value:
                    status_code: 401
                    code: UNAUTHORIZED
                    message: 인증이 필요합니다.
                  summary: 인증 필요
          description: Unauthorized
        '403':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'
              examples:
                관리자권한필요:
                  value:
                    status_code: 403
                    code: FORBIDDEN
                    message: 관리자 권한이 필요합니다.
                  summary: 관리자 권한 필요
          description: Forbidden
  /api/v1/admin/interaction-weight-rules/{interaction_type}/:
    patch:
      operationId: v1_admin_interaction_weight_rules_partial_update
      description: 관리자 권한으로 특정 행동 타입의 가중치 규칙을 수정합니다.
      summary: 행동 가중치 수정
      parameters:
      - in: path
        name: interaction_type
        schema:
          type: string
          enum:
          - dislike
          - like
          - preference_set
          - saved_add
          - saved_remove
          - search
          - store_click
          - view
        description: 행동 타입
        required: true
      tags:
      - admin
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedInteractionWeightRuleUpdateRequestRequest'
            examples:
              요청예시:
                value:
                  base_weight: 1.5
                  cooldown_seconds: 120
                summary: 요청 예시
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedInteractionWeightRuleUpdateRequestRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedInteractionWeightRuleUpdateRequestRequest'
      security:
      - jwtAuth: []
      - BearerAuth:
          type: http
          scheme: bearer
          bearerFormat: JWT
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/InteractionWeightRuleItem'
              examples:
                응답예시:
                  value:
                    interaction_type: view
                    base_weight: '1.50'
                    cooldown_seconds: 120
                    repeat_decay: '0.800'
                    updated_at: '2025-06-01T15:00:00Z'
                  summary: 응답 예시
          description: ''
        '400':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'
              examples:
                BaseWeight범위오류:
                  value:
                    status_code: 400
                    code: BASE_WEIGHT_INVALID
                    message: base_weight는 0보다 커야 합니다.
                  summary: base_weight 범위 오류
                입력값오류:
                  value:
                    status_code: 400
                    code: VALIDATION_ERROR
                    message: 입력값이 올바르지 않습니다.
                  summary: 입력값 오류
          description: Bad Request
        '401':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'
              examples:
                인증필요:
                  value:
                    status_code: 401
                    code: UNAUTHORIZED
                    message: 인증이 필요합니다.
                  summary: 인증 필요
          description: Unauthorized
        '403':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'
              examples:
                관리자권한필요:
                  value:
                    status_code: 403
                    code: FORBIDDEN
                    message: 관리자 권한이 필요합니다.
                  summary: 관리자 권한 필요
          description: Forbidden
        '404':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'
              examples:
                행동타입없음:
                  value:
                    status_code: 404
                    code: INTERACTION_TYPE_NOT_FOUND
                    message: 해당 interaction_type을 찾을 수 없습니다.
                  summary: 행동 타입 없음
          description: Not Found
  /api/v1/admin/recommendation-jobs/:
    get:
      operationId: v1_admin_recommendation_jobs_list
      description: 관리자 권한으로 추천 작업 목록을 조회합니다.
      summary: 추천 작업 목록 조회
      parameters:
      - in: query
        name: page
        schema:
          type: integer
        description: 조회할 페이지 번호
      - in: query
        name: page_size
        schema:
          type: integer
        description: '페이지당 결과 수 (최대: 100)'
      - in: query
        name: status
        schema:
          type: string
          enum:
          - failed
          - pending
          - running
          - success
        description: 작업 상태 필터
      - in: query
        name: type
        schema:
          type: string
          enum:
          - similarity_rebuild
          - user_refresh
        description: 작업 유형 필터
      tags:
      - admin
      security:
      - jwtAuth: []
      - BearerAuth:
          type: http
          scheme: bearer
          bearerFormat: JWT
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedRecommendationJobListResponseList'
              examples:
                응답예시:
                  value:
                    count: 123
                    next: http://api.example.org/accounts/?page=4
                    previous: http://api.example.org/accounts/?page=2
                    results:
                    - count: 1
                      next: null
                      previous: null
                      results:
                      - id: 15
                        type: user_refresh
                        status: success
                        target_user: 1
                        started_at: '2025-06-10T01:00:00Z'
                        created_at: '2025-06-10T00:59:00Z'
                  summary: 응답 예시
          description: ''
        '401':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'
              examples:
                인증필요:
                  value:
                    status_code: 401
                    code: UNAUTHORIZED
                    message: 인증이 필요합니다.
                  summary: 인증 필요
          description: Unauthorized
        '403':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'
              examples:
                관리자권한필요:
                  value:
                    status_code: 403
                    code: FORBIDDEN
                    message: 관리자 권한이 필요합니다.
                  summary: 관리자 권한 필요
          description: Forbidden
        '400':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'
              examples:
                잘못된쿼리파라미터:
                  value:
                    status_code: 400
                    code: INVALID_QUERY_PARAM
                    message: 유효하지 않은 쿼리 파라미터입니다.
                  summary: 잘못된 쿼리 파라미터
          description: Bad Request
  /api/v1/admin/recommendation-jobs/{job_id}/:
    get:
      operationId: v1_admin_recommendation_jobs_retrieve
      description: 관리자 권한으로 추천 작업 상세 정보를 조회합니다.
      summary: 추천 작업 상세 조회
      parameters:
      - in: path
        name: job_id
        schema:
          type: integer
        required: true
      tags:
      - admin
      security:
      - jwtAuth: []
      - BearerAuth:
          type: http
          scheme: bearer
          bearerFormat: JWT
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/RecommendationJobDetailResponse'
              examples:
                응답예시:
                  value:
                    id: 5
                    type: user_refresh
                    status: failed
                    target_user: 2
                    error_message: Connection timeout
                    started_at: '2025-06-10T01:00:00Z'
                    created_at: '2025-06-10T00:59:00Z'
                  summary: 응답 예시
          description: ''
        '401':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'
              examples:
                인증필요:
                  value:
                    status_code: 401
                    code: UNAUTHORIZED
                    message: 인증이 필요합니다.
                  summary: 인증 필요
          description: Unauthorized
        '403':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'
              examples:
                관리자권한필요:
                  value:
                    status_code: 403
                    code: FORBIDDEN
                    message: 관리자 권한이 필요합니다.
                  summary: 관리자 권한 필요
          description: Forbidden
        '404':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'
              examples:
                작업없음:
                  value:
                    status_code: 404
                    code: JOB_NOT_FOUND
                    message: 작업을 찾을 수 없습니다.
                  summary: 작업 없음
          description: Not Found
  /api/v1/admin/recommendation-jobs/run/:
    post:
      operationId: v1_admin_recommendation_jobs_run_create
      description: 관리자 권한으로 추천 작업을 수동 실행합니다.
      summary: 추천 작업 수동 실행
      tags:
      - admin
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/RecommendationJobRunRequestRequest'
            examples:
              요청예시:
                value:
                  job_type: user_refresh
                  target_user: null
                summary: 요청 예시
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/RecommendationJobRunRequestRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/RecommendationJobRunRequestRequest'
      security:
      - jwtAuth: []
      - BearerAuth:
          type: http
          scheme: bearer
          bearerFormat: JWT
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/RecommendationJobRunResponse'
              examples:
                응답예시:
                  value:
                    id: 11
                    type: user_refresh
                    status: pending
                    created_at: '2025-08-01T12:00:00Z'
                  summary: 응답 예시
          description: ''
        '400':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'
              examples:
                JobType누락:
                  value:
                    status_code: 400
                    code: JOB_TYPE_MISSING
                    message: job_type이 누락되었습니다.
                  summary: job_type 누락
          description: Bad Request
        '401':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'
              examples:
                인증필요:
                  value:
                    status_code: 401
                    code: UNAUTHORIZED
                    message: 인증이 필요합니다.
                  summary: 인증 필요
          description: Unauthorized
        '403':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'
              examples:
                관리자권한필요:
                  value:
                    status_code: 403
                    code: FORBIDDEN
                    message: 관리자 권한이 필요합니다.
                  summary: 관리자 권한 필요
          description: Forbidden
        '409':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'
              examples:
                이미실행중인작업:
                  value:
                    status_code: 409
                    code: JOB_ALREADY_RUNNING
                    message: 이미 실행 중인 작업이 있습니다.
                  summary: 이미 실행 중인 작업
          description: Conflict
  /api/v1/admin/users/:
    get:
      operationId: v1_admin_users_list
      summary: 어드민 - 유저 목록 조회
      parameters:
      - in: query
        name: page
        schema:
          type: integer
        description: 조회할 페이지 번호
      - in: query
        name: page_size
        schema:
          type: integer
        description: '페이지당 결과 수 (최대: 100)'
      tags:
      - admin
      security:
      - jwtAuth: []
      - BearerAuth:
          type: http
          scheme: bearer
          bearerFormat: JWT
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedAdminUserListResponseList'
          description: ''
        '401':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'
          description: ''
        '403':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'
          description: ''
  /api/v1/admin/users/{user_id}/:
    get:
      operationId: v1_admin_users_retrieve
      summary: 어드민 - 유저 상세 조회
      parameters:
      - in: path
        name: user_id
        schema:
          type: integer
        required: true
      tags:
      - admin
      security:
      - jwtAuth: []
      - BearerAuth:
          type: http
          scheme: bearer
          bearerFormat: JWT
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AdminUserDetailResponse'
          description: ''
        '401':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'
          description: ''
        '403':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'
          description: ''
        '404':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'
          description: User not found
    patch:
      operationId: v1_admin_users_partial_update
      summary: 어드민 - 유저 상태 변경
      parameters:
      - in: path
        name: user_id
        schema:
          type: integer
        required: true
      tags:
      - admin
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/PatchedAdminUserStatusUpdateRequestRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/PatchedAdminUserStatusUpdateRequestRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/PatchedAdminUserStatusUpdateRequestRequest'
      security:
      - jwtAuth: []
      - BearerAuth:
          type: http
          scheme: bearer
          bearerFormat: JWT
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AdminUserDetailResponse'
          description: ''
        '401':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'
          description: ''
        '403':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'
          description: ''
        '404':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ErrorResponse'
          description: User not found
  /api/v1/auth/discord/callback/:
    get:
      operationId: v1_auth_discord_callback_retrieve
      summary: 디스코드 로그인 콜백 처리
      parameters:
      - in: query
        name: code
        schema:
          type: string
        description: 디스코드 OAuth 인증 코드
        required: true
      - in: query
        name: state
        schema:
          type: string
        description: 디스코드 OAuth state 값
