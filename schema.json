components:
  schemas:
    AccountRestoreRequestRequest:
      type: object
      properties:
        email:
          type: string
          format: email
          minLength: 1
        password:
          type: string
          writeOnly: true
          minLength: 1
      required:
      - email
      - password
    AdminUserDetailResponse:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        email:
          type: string
          format: email
          maxLength: 254
        nickname:
          type: string
          maxLength: 30
        birth_date:
          type: string
          format: date
        profile_img_url:
          type: string
          nullable: true
          maxLength: 255
        is_active:
          type: boolean
        is_staff:
          type: boolean
        is_superuser:
          type: boolean
        is_adult_verified:
          type: boolean
        adult_verified_at:
          type: string
          format: date-time
          nullable: true
        adult_verification_expires_at:
          type: string
          format: date-time
          nullable: true
        deleted_at:
          type: string
          format: date-time
          nullable: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - birth_date
      - created_at
      - email
      - id
      - nickname
      - updated_at
    AdminUserListItem:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        email:
          type: string
          format: email
          maxLength: 254
        nickname:
          type: string
          maxLength: 30
        is_active:
          type: boolean
        is_staff:
          type: boolean
        is_superuser:
          type: boolean
        is_adult_verified:
          type: boolean
        deleted_at:
          type: string
          format: date-time
          nullable: true
        created_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - email
      - id
      - nickname
    AdminUserListResponse:
      type: object
      properties:
        count:
          type: integer
        next:
          type: string
          nullable: true
        previous:
          type: string
          nullable: true
        results:
